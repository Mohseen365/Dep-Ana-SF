const { chromium } = require("playwright");

(async () => {
  const browser = await chromium.launch({ headless: true });
  const page = await browser.newPage();

  page.on("pageerror", error =>
    console.log("PAGE_ERROR:", error.message)
  );

  await page.goto("http://127.0.0.1:3000/", {
    waitUntil: "networkidle"
  });

  const before = await page.evaluate(() => {
    const cy = window.__CY__;
    const node = cy?.getElementById("ApexClass:SampleHelper");

    if (!node || node.empty()) {
      throw new Error("Target node not found");
    }

    return {
      position: node.position(),
      projectStateKeys: Object.keys(localStorage)
        .filter(key => key.startsWith("explorer.projectState.")),
      projectStates: Object.fromEntries(
        Object.keys(localStorage)
          .filter(key => key.startsWith("explorer.projectState."))
          .map(key => [key, localStorage.getItem(key)])
      )
    };
  });

  console.log("BEFORE:", JSON.stringify(before, null, 2));

  await page.evaluate(() => {
    const cy = window.__CY__;
    const node = cy.getElementById("ApexClass:SampleHelper");

    // Move through Cytoscape's position API and emit the same
    // drag lifecycle events used by the app's persistence handler.
    node.emit("grab");
    node.position({
      x: beforePosition.x + 80,
      y: beforePosition.y + 60
    });
    node.emit("free");
  });

  const after = await page.evaluate(() => {
    const node = window.__CY__.getElementById("ApexClass:SampleHelper");

    return {
      position: node.position(),
      projectStateKeys: Object.keys(localStorage)
        .filter(key => key.startsWith("explorer.projectState.")),
      projectStates: Object.fromEntries(
        Object.keys(localStorage)
          .filter(key => key.startsWith("explorer.projectState."))
          .map(key => [key, localStorage.getItem(key)])
      )
    };
  });

  console.log("AFTER:", JSON.stringify(after, null, 2));

  await browser.close();
})().catch(error => {
  console.error(error);
  process.exit(1);
});
