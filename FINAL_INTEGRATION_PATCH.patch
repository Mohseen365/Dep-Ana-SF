++
++                appliedActionsCount++;
++                breakCycleActionsApplied++;
++                actionLogs.push({
++                    actionId: action.id,
++                    type: 'EXTRACT_INTERFACE',
++                    description: `Extracted interface '${ifaceId}' between '${action.sourceNodeId}' and '${action.targetNodeId}'.`
++                });
