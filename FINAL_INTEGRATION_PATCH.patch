++export function computeTarjanSCC(nodes, edges) {
++    const nodeIds = new Set((nodes || []).map(n => n.id));
++    const adj = new Map();
++    for (const id of nodeIds) {
++        adj.set(id, []);
++    }
++
++    for (const e of (edges || [])) {
++        if (nodeIds.has(e.source) && nodeIds.has(e.target)) {
++            adj.get(e.source).push(e.target);
++        }
++    }
++
++    let index = 0;
++    const indices = new Map();
++    const lowlink = new Map();
++    const onStack = new Map();
++    const stack = [];
++    const sccs = [];
++
++    function strongConnect(v) {
++        indices.set(v, index);
++        lowlink.set(v, index);
++        index++;
++        stack.push(v);
++        onStack.set(v, true);
++
++        const neighbors = adj.get(v) || [];
++        for (const w of neighbors) {
++            if (!indices.has(w)) {
++                strongConnect(w);
++                lowlink.set(v, Math.min(lowlink.get(v), lowlink.get(w)));
++            } else if (onStack.get(w)) {
++                lowlink.set(v, Math.min(lowlink.get(v), indices.get(w)));
++            }
++        }
++
++        if (lowlink.get(v) === indices.get(v)) {
++            const scc = [];
++            let w = null;
++            do {
++                w = stack.pop();
++                onStack.set(w, false);
++                scc.push(w);
++            } while (w !== v);
++            sccs.push(scc);
++        }
++    }
++
++    for (const v of nodeIds) {
++        if (!indices.has(v)) {
++            strongConnect(v);
++        }
++    }
++
++    return sccs;
++}
++
++export function countCyclicSCCs(nodes, edges) {
++    const sccs = computeTarjanSCC(nodes, edges);
++    const selfLoopNodes = new Set();
++    for (const e of (edges || [])) {
++        if (e.source === e.target) {
++            selfLoopNodes.add(e.source);
++        }
++    }
++
++    let cyclicCount = 0;
++    for (const scc of sccs) {
++        if (scc.length > 1) {
++            cyclicCount++;
++        } else if (scc.length === 1 && selfLoopNodes.has(scc[0])) {
++            cyclicCount++;
++        }
++    }
++    return cyclicCount;
++}
++
++export function edgeParticipatesInDirectedCycle(edge, edges) {
++    if (!edge) return false;
++    const u = edge.source;
++    const v = edge.target;
++
++    if (u === v) {
++        return true;
++    }
++
++    const adj = new Map();
++    const candidateEdgeId = edge.id || `${u}->${v}`;
++    let candidateEdgeMatched = false;
++
++    for (const e of (edges || [])) {
++        const eId = e.id || `${e.source}->${e.target}`;
++        if (!candidateEdgeMatched && (eId === candidateEdgeId || (e.source === u && e.target === v))) {
++            candidateEdgeMatched = true;
++            continue;
++        }
++        if (!adj.has(e.source)) {
++            adj.set(e.source, []);
++        }
++        adj.get(e.source).push(e.target);
++    }
++
++    const visited = new Set();
++    const queue = [v];
++    visited.add(v);
++
++    while (queue.length > 0) {
++        const curr = queue.shift();
++        if (curr === u) {
++            return true;
++        }
++        const neighbors = adj.get(curr) || [];
++        for (const nxt of neighbors) {
++            if (!visited.has(nxt)) {
++                visited.add(nxt);
++                queue.push(nxt);
++            }
++        }
++    }
++
++    return false;
++}
