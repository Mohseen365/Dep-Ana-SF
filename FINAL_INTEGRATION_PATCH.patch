++export function deepCloneGraph(graph) {
++    if (!graph || typeof graph !== 'object') {
++        return { schemaVersion: '1.0.0', nodes: [], edges: [], metrics: {} };
++    }
++    return JSON.parse(JSON.stringify(graph));
++}
