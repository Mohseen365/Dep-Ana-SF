+                    count: c.count
+                }))
+            }))
+        };
+
+        const jsonStr = JSON.stringify(dataToExport, null, 2);
+        this.triggerDownload(`dependency-matrix-${this.projectId || 'project'}-${Date.now()}.json`, 'application/json', jsonStr);
+    }
+
+    handleExportCSV() {
