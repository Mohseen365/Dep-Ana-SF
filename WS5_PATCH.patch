+<template>
+    <div class="project-dashboard-container slds-p-around_medium">
+        <!-- Header Tile -->
+        <article class="slds-card slds-m-bottom_medium header-card">
+            <div class="slds-card__header slds-grid slds-grid_align-spread slds-grid_vertical-align-center">
+                <header class="slds-media slds-media_center slds-has-flexi-truncate">
+                    <div class="slds-media__figure">
+                        <span class="slds-icon_container slds-icon-standard-dashboard" title="Portfolio Dashboard">
+                            <span class="dashboard-icon">📊</span>
+                        </span>
+                    </div>
+                    <div class="slds-media__body">
+                        <h2 class="slds-card__header-title">
+                            <span class="slds-text-heading_small">{activeProjectName}</span>
+                        </h2>
+                        <p class="slds-text-body_small slds-text-color_weak">
+                            Key: <code>{activeProjectKey}</code> | Status: <span class={projectStatusBadgeClass}>{projectStatus}</span>
+                        </p>
+                    </div>
+                </header>
+                <div class="slds-no-flex header-actions">
+                    <button class="slds-button slds-button_brand" onclick={handleExploreGraph} disabled={isExploreDisabled}>
+                        🕸️ Explore Dependency Graph
+                    </button>
+                    <button class="slds-button slds-button_neutral" onclick={handleRefresh}>
+                        🔄 Refresh
+                    </button>
+                </div>
+            </div>
+        </article>
+
+        <!-- Loading State -->
+        <template if:true={isLoading}>
+            <div class="slds-notify slds-notify_alert slds-theme_info slds-m-bottom_medium" role="alert">
+                <span class="slds-assistive-text">Loading</span>
+                <h2>Loading project metrics and architecture intelligence...</h2>
+            </div>
+        </template>
+
+        <!-- Error State -->
+        <template if:true={errorMessage}>
+            <div class="slds-notify slds-notify_alert slds-alert_error slds-m-bottom_medium" role="alert">
+                <span class="slds-assistive-text">Error</span>
+                <h2>{errorMessage}</h2>
+            </div>
+        </template>
+
+        <!-- Summary Metric Cards -->
+        <div class="slds-grid slds-gutters slds-m-bottom_medium metric-grid">
+            <div class="slds-col slds-size_1-of-2 slds-medium-size_1-of-4">
+                <div class="slds-box slds-box_small slds-theme_shade metric-card">
+                    <div class="metric-label">Components (Nodes)</div>
+                    <div class="metric-value font-mono">{totalNodes}</div>
+                    <div class="metric-trend">{nodeTrendText}</div>
+                </div>
+            </div>
+            <div class="slds-col slds-size_1-of-2 slds-medium-size_1-of-4">
+                <div class="slds-box slds-box_small slds-theme_shade metric-card">
+                    <div class="metric-label">Dependencies (Edges)</div>
+                    <div class="metric-value font-mono">{totalEdges}</div>
+                    <div class="metric-trend">{edgeTrendText}</div>
+                </div>
+            </div>
+            <div class="slds-col slds-size_1-of-2 slds-medium-size_1-of-4">
+                <div class="slds-box slds-box_small slds-theme_shade metric-card">
+                    <div class="metric-label">Cyclic SCC Count</div>
+                    <div class={cyclicSccClass}>{totalCycles}</div>
+                    <div class="metric-trend">{cycleTrendText}</div>
+                </div>
+            </div>
+            <div class="slds-col slds-size_1-of-2 slds-medium-size_1-of-4">
+                <div class="slds-box slds-box_small slds-theme_shade metric-card">
+                    <div class="metric-label">Recorded Analyses</div>
+                    <div class="metric-value font-mono">{runCount}</div>
+                    <div class="metric-trend">{lastAnalyzedFormatted}</div>
+                </div>
+            </div>
+        </div>
+
+        <!-- History & Trend Table -->
+        <article class="slds-card">
+            <div class="slds-card__header slds-grid">
+                <header class="slds-media slds-media_center slds-has-flexi-truncate">
+                    <div class="slds-media__body">
+                        <h2 class="slds-card__header-title">
+                            <span class="slds-text-heading_small">Recent Analysis Runs & Architectural Churn</span>
+                        </h2>
+                    </div>
+                </header>
+            </div>
+            <div class="slds-card__body slds-card__body_inner">
+                <!-- Empty State -->
+                <template if:true={isEmpty}>
+                    <div class="slds-illustration slds-illustration_small slds-p-around_medium empty-illustration">
+                        <div class="slds-text-longform">
+                            <h3 class="slds-text-heading_medium">No Analysis Runs Found</h3>
+                            <p class="slds-text-body_regular">No architecture analysis snapshots have been ingested yet for this project.</p>
+                        </div>
+                    </div>
+                </template>
+
+                <template if:false={isEmpty}>
+                    <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered" aria-label="Analysis History Table">
+                        <thead>
+                            <tr class="slds-line-height_reset">
+                                <th scope="col"><div class="slds-truncate" title="Run Date">Run Timestamp</div></th>
+                                <th scope="col"><div class="slds-truncate" title="Commit">Commit</div></th>
+                                <th scope="col"><div class="slds-truncate" title="Status">Status</div></th>
+                                <th scope="col"><div class="slds-truncate" title="Nodes">Nodes (Δ)</div></th>
+                                <th scope="col"><div class="slds-truncate" title="Edges">Edges (Δ)</div></th>
+                                <th scope="col"><div class="slds-truncate" title="Cyclic SCCs">Cycles (Δ)</div></th>
+                                <th scope="col"><div class="slds-truncate" title="Action">Action</div></th>
+                            </tr>
+                        </thead>
+                        <tbody>
+                            <template for:each={formattedRuns} for:item="r">
+                                <tr key={r.runId} class={r.rowClass}>
+                                    <td><div class="slds-truncate">{r.formattedTime}</div></td>
+                                    <td><code>{r.shortCommit}</code></td>
+                                    <td>
+                                        <span class={r.statusBadgeClass}>{r.status}</span>
+                                    </td>
+                                    <td>
+                                        <span class="font-mono">{r.nodeCount}</span>
+                                        <span if:true={r.hasNodeDelta} class={r.nodeDeltaClass}> ({r.formattedNodeDelta})</span>
+                                    </td>
+                                    <td>
+                                        <span class="font-mono">{r.edgeCount}</span>
+                                        <span if:true={r.hasEdgeDelta} class={r.edgeDeltaClass}> ({r.formattedEdgeDelta})</span>
+                                    </td>
+                                    <td>
+                                        <span class={r.cyclesClass}>{r.cyclicSccCount}</span>
+                                        <span if:true={r.hasCyclesDelta} class={r.cyclesDeltaClass}> ({r.formattedCyclesDelta})</span>
+                                    </td>
+                                    <td>
+                                        <button class="slds-button slds-button_neutral slds-button_small" data-id={r.runId} data-hash={r.commitHash} onclick={handleSelectRun}>
+                                            View
+                                        </button>
+                                    </td>
+                                </tr>
+                            </template>
+                        </tbody>
+                    </table>
+                </template>
+            </div>
+        </article>
+    </div>
+</template>
diff --git a/scratch/salesforce-poc/force-app/main/default/lwc/daProjectDashboard/daProjectDashboard.js b/scratch/salesforce-poc/force-app/main/default/lwc/daProjectDashboard/daProjectDashboard.js
new file mode 100644
index 0000000..473091c
--- /dev/null
+++ b/scratch/salesforce-poc/force-app/main/default/lwc/daProjectDashboard/daProjectDashboard.js
@@ -0,0 +1,216 @@
+import { LightningElement, api, track } from 'lwc';
+import getProjects from '@salesforce/apex/DAGraphController.getProjects';
+import getAnalysisRuns from '@salesforce/apex/DAAnalysisHistoryController.getAnalysisRuns';
+
+export default class DaProjectDashboard extends LightningElement {
+    @api projectId = null;
+    @api projectKey = null;
+
+    @track projects = [];
+    @track runs = [];
+    @track isLoading = false;
+    @track errorMessage = '';
+    @track activeRunId = null;
+
+    connectedCallback() {
+        this.initializeDashboard();
+    }
+
+    @api
+    async initializeDashboard() {
+        this.isLoading = true;
+        this.errorMessage = '';
+        try {
+            const projectList = await getProjects();
+            this.projects = Array.isArray(projectList) ? projectList : [];
+
+            if (!this.projectId && this.projects.length > 0) {
+                const first = this.projects[0];
+                this.projectId = first.Id;
+                this.projectKey = first.Project_Key__c || first.Name;
+            }
+
+            if (this.projectId) {
+                await this.loadProjectRuns();
+            }
+        } catch (err) {
+            this.errorMessage = err && err.body && err.body.message ? err.body.message : (err.message || 'Error initializing dashboard.');
+        } finally {
+            this.isLoading = false;
+        }
+    }
+
+    async loadProjectRuns() {
+        if (!this.projectId) {
+            this.runs = [];
+            return;
+        }
+
+        try {
+            const runList = await getAnalysisRuns({
+                projectId: this.projectId,
+                queryLimit: 25,
+                queryOffset: 0
+            });
+            this.runs = Array.isArray(runList) ? runList : [];
+            if (this.runs.length > 0 && !this.activeRunId) {
+                this.activeRunId = this.runs[0].runId;
+            }
+        } catch (err) {
+            this.errorMessage = err && err.body && err.body.message ? err.body.message : (err.message || 'Error loading project runs.');
+            this.runs = [];
+        }
+    }
+
+    get activeProject() {
+        return (this.projects || []).find(p => p.Id === this.projectId || p.Project_Key__c === this.projectId) || null;
+    }
+
+    get activeProjectName() {
+        const p = this.activeProject;
+        return p ? p.Name : (this.projectKey || 'Salesforce DX Architecture Portfolio');
+    }
+
+    get activeProjectKey() {
+        const p = this.activeProject;
+        return p ? (p.Project_Key__c || p.Name) : (this.projectKey || 'N/A');
+    }
+
+    get projectStatus() {
+        if (!this.projectId) return 'NO_PROJECT';
+        if (this.runs.length === 0) return 'NOT_ANALYZED';
+        const latest = this.runs[0];
+        return latest.status || 'AVAILABLE';
+    }
+
+    get projectStatusBadgeClass() {
+        const status = this.projectStatus;
+        if (status === 'AVAILABLE') return 'slds-badge slds-theme_success';
+        if (status === 'FAILED') return 'slds-badge slds-theme_error';
+        if (status === 'EMPTY' || status === 'NOT_ANALYZED') return 'slds-badge slds-theme_warning';
+        return 'slds-badge slds-theme_shade';
+    }
+
+    get isExploreDisabled() {
+        return !this.projectId || this.runs.length === 0 || this.isLoading;
+    }
+
+    get isEmpty() {
+        return !this.isLoading && (!this.runs || this.runs.length === 0);
+    }
+
+    get runCount() {
+        return this.runs.length;
+    }
+
+    get latestRun() {
+        return this.runs.length > 0 ? this.runs[0] : null;
+    }
+
+    get totalNodes() {
+        const latest = this.latestRun;
+        return latest && latest.nodeCount != null ? latest.nodeCount : 0;
+    }
+
+    get totalEdges() {
+        const latest = this.latestRun;
+        return latest && latest.edgeCount != null ? latest.edgeCount : 0;
+    }
+
+    get totalCycles() {
+        const latest = this.latestRun;
+        return latest && latest.cyclicSccCount != null ? latest.cyclicSccCount : 0;
+    }
+
+    get cyclicSccClass() {
+        return this.totalCycles > 0 ? 'metric-value font-mono text-danger' : 'metric-value font-mono text-success';
+    }
+
+    get nodeTrendText() {
+        const latest = this.latestRun;
+        if (!latest || latest.nodeDelta === 0) return 'Stable';
+        return latest.nodeDelta > 0 ? `+${latest.nodeDelta} vs previous` : `${latest.nodeDelta} vs previous`;
+    }
+
+    get edgeTrendText() {
+        const latest = this.latestRun;
+        if (!latest || latest.edgeDelta === 0) return 'Stable';
+        return latest.edgeDelta > 0 ? `+${latest.edgeDelta} vs previous` : `${latest.edgeDelta} vs previous`;
+    }
+
+    get cycleTrendText() {
+        const latest = this.latestRun;
+        if (!latest || latest.cyclicSccDelta === 0) return 'Zero change';
+        return latest.cyclicSccDelta > 0 ? `+${latest.cyclicSccDelta} cycles added` : `${latest.cyclicSccDelta} cycles resolved`;
+    }
+
+    get lastAnalyzedFormatted() {
+        const latest = this.latestRun;
+        if (!latest || !latest.runTimestamp) return 'No runs recorded';
+        return new Date(latest.runTimestamp).toLocaleDateString();
+    }
+
+    get formattedRuns() {
+        return (this.runs || []).map(r => {
+            const isActive = r.runId === this.activeRunId;
+            const shortCommit = r.commitHash ? r.commitHash.substring(0, 7) : 'n/a';
+            const formattedTime = r.runTimestamp ? new Date(r.runTimestamp).toLocaleString() : '';
+
+            const nodeDelta = r.nodeDelta || 0;
+            const edgeDelta = r.edgeDelta || 0;
+            const cyclesDelta = r.cyclicSccDelta || 0;
+
+            return {
+                ...r,
+                isActive,
+                shortCommit,
+                formattedTime,
+                rowClass: isActive ? 'slds-is-selected active-row' : '',
+                statusBadgeClass: r.status === 'AVAILABLE' ? 'slds-badge slds-theme_success' : (r.status === 'FAILED' ? 'slds-badge slds-theme_error' : 'slds-badge slds-theme_shade'),
+                hasNodeDelta: nodeDelta !== 0,
+                formattedNodeDelta: nodeDelta > 0 ? `+${nodeDelta}` : `${nodeDelta}`,
+                nodeDeltaClass: nodeDelta > 0 ? 'delta-pill delta-positive' : 'delta-pill delta-negative',
+                hasEdgeDelta: edgeDelta !== 0,
+                formattedEdgeDelta: edgeDelta > 0 ? `+${edgeDelta}` : `${edgeDelta}`,
+                edgeDeltaClass: edgeDelta > 0 ? 'delta-pill delta-positive' : 'delta-pill delta-negative',
+                hasCyclesDelta: cyclesDelta !== 0,
+                formattedCyclesDelta: cyclesDelta > 0 ? `+${cyclesDelta}` : `${cyclesDelta}`,
+                cyclesDeltaClass: cyclesDelta > 0 ? 'delta-pill delta-danger' : 'delta-pill delta-success',
+                cyclesClass: (r.cyclicSccCount || 0) > 0 ? 'text-danger font-mono font-bold' : 'font-mono'
+            };
+        });
+    }
+
+    handleRefresh() {
+        this.initializeDashboard();
+    }
+
+    handleExploreGraph() {
+        if (!this.projectId) return;
+        this.dispatchEvent(new CustomEvent('viewgraph', {
+            detail: {
+                projectId: this.projectId,
+                projectKey: this.activeProjectKey,
+                runId: this.activeRunId
+            },
+            bubbles: true,
+            composed: true
+        }));
+    }
+
+    handleSelectRun(event) {
+        const runId = event.currentTarget.dataset.id;
+        const commitHash = event.currentTarget.dataset.hash;
+        this.activeRunId = runId;
+
+        this.dispatchEvent(new CustomEvent('runselect', {
+            detail: {
+                runId,
+                commitHash,
+                projectId: this.projectId
+            },
+            bubbles: true,
+            composed: true
+        }));
+    }
+}
