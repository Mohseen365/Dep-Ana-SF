+.treemap-container {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    width: 100%;
+    background-color: #0b1120;
+    color: #e2e8f0;
+    overflow: hidden;
+    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+}
+
+.treemap-toolbar {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0.75rem 1rem;
+    border-bottom: 1px solid #1e293b;
+    background-color: #0f172a;
+    gap: 1rem;
+}
+
+.treemap-controls {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+}
+
+.control-label {
+    font-size: 0.8125rem;
+    color: #94a3b8;
+}
+
+.control-select {
+    background-color: #1e293b;
+    color: #f1f5f9;
+    border: 1px solid #334155;
+    border-radius: 4px;
+    padding: 0.25rem 0.5rem;
+    font-size: 0.8125rem;
+}
+
+.treemap-canvas {
+    flex: 1;
+    position: relative;
+    padding: 1rem;
+    box-sizing: border-box;
+    overflow: auto;
+}
+
+.treemap-svg {
+    width: 100%;
+    height: 100%;
+    min-height: 480px;
+    display: block;
+}
+
+.treemap-node-rect {
+    transition: opacity 0.15s ease, stroke-width 0.15s ease;
+    cursor: pointer;
+}
+
+.treemap-node-rect:hover {
+    filter: brightness(1.2);
+}
+
+.treemap-node-rect.selected {
+    stroke: #38bdf8 !important;
+    stroke-width: 2.5px !important;
+}
+
+.treemap-empty, .treemap-error {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    height: 100%;
+    min-height: 360px;
+    color: #64748b;
+    font-size: 0.9375rem;
+    gap: 0.5rem;
+}
+
+.treemap-tooltip {
+    position: absolute;
+    bottom: 1rem;
+    left: 1rem;
+    background-color: rgba(15, 23, 42, 0.95);
+    border: 1px solid #334155;
+    border-radius: 4px;
+    padding: 0.5rem 0.75rem;
+    font-size: 0.75rem;
+    pointer-events: none;
+    z-index: 10;
+}
