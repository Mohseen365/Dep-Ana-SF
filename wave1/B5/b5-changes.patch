+
+// -------------------------------------------------------------
+// 12. STATIC METADATA SIZE & LIMITS
+// -------------------------------------------------------------
+const largeFiles = [];
+const allPocFiles = listFilesRecursive(FORCE_APP);
+for (const f of allPocFiles) {
