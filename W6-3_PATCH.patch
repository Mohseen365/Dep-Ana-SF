+.subway-container {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    width: 100%;
+    background-color: #0b1120;
+    color: #f1f5f9;
+    overflow: hidden;
+    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+}
+
+.subway-toolbar {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0.75rem 1rem;
+    border-bottom: 1px solid #1e293b;
+    background-color: #0f172a;
+    gap: 1rem;
+}
+
+.subway-controls {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+}
+
+.control-label {
+    font-size: 0.8125rem;
+    color: #94a3b8;
+}
+
+.control-input, .control-select {
+    background-color: #1e293b;
+    color: #f1f5f9;
+    border: 1px solid #334155;
+    border-radius: 4px;
+    padding: 0.25rem 0.5rem;
+    font-size: 0.8125rem;
+}
+
+.subway-canvas {
+    flex: 1;
+    position: relative;
+    padding: 1rem;
+    box-sizing: border-box;
+    overflow: auto;
+}
+
+.subway-svg {
+    width: 100%;
+    height: 100%;
+    min-height: 520px;
+    display: block;
+}
+
+.station-node {
+    cursor: pointer;
+    transition: transform 0.1s ease, filter 0.15s ease;
+}
+
+.station-node:hover circle {
+    filter: brightness(1.3);
+    stroke-width: 3px;
+}
+
+.station-node.selected circle {
+    stroke: #38bdf8 !important;
+    stroke-width: 3.5px !important;
+}
+
+.subway-empty, .subway-error {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    height: 100%;
+    min-height: 360px;
+    color: #64748b;
+    font-size: 0.9375rem;
+    gap: 0.5rem;
+}
