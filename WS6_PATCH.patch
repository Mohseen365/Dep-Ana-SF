+                                    </div>
+                                </div>
+                                <div class="slds-col slds-size_1-of-2 slds-m-bottom_x-small">
+                                    <div class="metric-card">
+                                        <div class="metric-value">{linesOfCode}</div>
+                                        <div class="metric-label">Lines of Code</div>
+                                    </div>
+                                </div>
+                                <div class="slds-col slds-size_1-of-2 slds-m-bottom_x-small">
+                                    <div class="metric-card">
+                                        <div class="metric-value">{cyclomaticComplexity}</div>
+                                        <div class="metric-label">Complexity</div>
+                                    </div>
+                                </div>
+                            </div>
+                        </div>
+                    </lightning-tab>
+
+                    <!-- Dependencies & 1-Hop Tab -->
+                    <lightning-tab label={dependencyTabLabel} value="dependencies">
+                        <div class="slds-p-around_small">
+                            <!-- Inbound Edges (Fan-In) -->
+                            <div class="slds-text-title_caps slds-m-bottom_x-small slds-grid slds-grid_align-spread">
+                                <span>Inbound (Fan-In: {fanInCount})</span>
+                            </div>
+                            <template if:false={hasInboundEdges}>
+                                <p class="slds-text-color_weak slds-text-body_small slds-m-bottom_medium">
+                                    No incoming dependencies found.
+                                </p>
+                            </template>
+                            <template if:true={hasInboundEdges}>
+                                <div class="slds-m-bottom_medium">
+                                    <template for:each={inboundEdges} for:item="edge">
+                                        <div
+                                            key={edge.id}
+                                            class="dependency-item slds-grid slds-grid_align-spread slds-grid_vertical-align-center"
+                                            data-id={edge.source}
+                                            onclick={handleNeighborClick}>
+                                            <div class="slds-truncate" title={edge.source}>
+                                                <strong>{edge.sourceLabel}</strong>
+                                                <span class="slds-text-color_weak slds-m-left_xx-small">({edge.type})</span>
+                                            </div>
+                                            <lightning-icon icon-name="utility:chevronright" size="xx-small"></lightning-icon>
+                                        </div>
+                                    </template>
+                                </div>
+                            </template>
+
+                            <!-- Outbound Edges (Fan-Out) -->
+                            <div class="slds-text-title_caps slds-m-bottom_x-small slds-grid slds-grid_align-spread">
+                                <span>Outbound (Fan-Out: {fanOutCount})</span>
+                            </div>
+                            <template if:false={hasOutboundEdges}>
+                                <p class="slds-text-color_weak slds-text-body_small slds-m-bottom_medium">
+                                    No outgoing dependencies found.
+                                </p>
+                            </template>
+                            <template if:true={hasOutboundEdges}>
+                                <div class="slds-m-bottom_medium">
+                                    <template for:each={outboundEdges} for:item="edge">
+                                        <div
+                                            key={edge.id}
+                                            class="dependency-item slds-grid slds-grid_align-spread slds-grid_vertical-align-center"
+                                            data-id={edge.target}
+                                            onclick={handleNeighborClick}>
+                                            <div class="slds-truncate" title={edge.target}>
+                                                <strong>{edge.targetLabel}</strong>
+                                                <span class="slds-text-color_weak slds-m-left_xx-small">({edge.type})</span>
+                                            </div>
+                                            <lightning-icon icon-name="utility:chevronright" size="xx-small"></lightning-icon>
+                                        </div>
+                                    </template>
+                                </div>
+                            </template>
+                        </div>
+                    </lightning-tab>
+
+                    <!-- Associated Findings Tab -->
+                    <lightning-tab label={findingsTabLabel} value="findings">
+                        <div class="slds-p-around_small">
+                            <template if:false={hasNodeFindings}>
+                                <p class="slds-text-color_weak slds-text-body_small">
+                                    No rule violations or findings reported for this component.
+                                </p>
+                            </template>
+                            <template if:true={hasNodeFindings}>
+                                <template for:each={nodeFindings} for:item="finding">
+                                    <div key={finding.id} class="slds-box slds-box_x-small slds-m-bottom_x-small">
+                                        <div class="slds-grid slds-grid_align-spread slds-m-bottom_xx-small">
+                                            <span class="slds-badge slds-theme_warning">{finding.severity}</span>
+                                            <span class="slds-text-color_weak slds-text-body_small">{finding.ruleId}</span>
+                                        </div>
+                                        <p class="slds-text-body_small">{finding.details}</p>
+                                    </div>
+                                </template>
+                            </template>
+                        </div>
+                    </lightning-tab>
+
+                    <!-- Annotations Tab -->
+                    <lightning-tab label="Annotations" value="annotations">
+                        <div class="slds-p-around_small">
+                            <c-da-annotation-panel
+                                project-id={projectId}
+                                selected-node-id={selectedNodeId}>
+                            </c-da-annotation-panel>
+                        </div>
+                    </lightning-tab>
+                </lightning-tabset>
+            </template>
+        </div>
+    </div>
+</template>
diff --git a/scratch/salesforce-poc/force-app/main/default/lwc/daInvestigationDrawer/daInvestigationDrawer.js b/scratch/salesforce-poc/force-app/main/default/lwc/daInvestigationDrawer/daInvestigationDrawer.js
